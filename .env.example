# Mode — set OFFLINE=true if no internet (uses .local domains, no SSL certs)
OFFLINE=true

# Domain for your site — .local works offline via /etc/hosts
DOMAIN=basapos.local

# Let's Encrypt email — only needed when OFFLINE=false
# LETSENCRYPT_EMAIL=admin@example.com

# Database
DB_PASSWORD=change_this_to_random_password

# Admin password for new sites
ADMIN_PASSWORD=admin

# Docker image
CUSTOM_IMAGE=basapos
CUSTOM_TAG=16
PULL_POLICY=missing
