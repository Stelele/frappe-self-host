# Domains — pick ONE style:
#   Simple:  DOMAIN=erpnext.example.com
#   Advanced (multi-domain): SITES_RULE=Host(`a.com`) || Host(`b.com`)
DOMAIN=erpnext.example.com

# Let's Encrypt SSL (auto via Traefik)
LETSENCRYPT_EMAIL=admin@example.com

# Database (DB_HOST/DB_PORT are auto-set by compose.mariadb.yaml)
DB_PASSWORD=change_this_to_random_password

# Admin password for new sites
ADMIN_PASSWORD=admin

# Docker image (leave as-is unless you change the tag)
CUSTOM_IMAGE=BasaPOS
CUSTOM_TAG=16
