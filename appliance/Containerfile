# BasaPOS WSL appliance — built from repo root:
#   docker build -f appliance/Containerfile -t basapos-appliance:16 .
FROM ubuntu@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

# ---- system packages --------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg lsb-release sudo jq \
      build-essential pkg-config \
      python3.10 python3.10-dev python3-pip python3.10-venv \
      libpython3.10-dev libffi-dev libssl-dev libmariadb-dev \
      mariadb-server mariadb-client \
      redis-server \
      nginx \
      fontconfig libxrender1 libxext6 xfonts-75dpi xfonts-base \
      openssl cron file tzdata \
      zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
      libncursesw5-dev xz-utils liblzma-dev uuid-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- Node 24 -----------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install --global yarn@1.22.19 \
    && rm -rf /var/lib/apt/lists/*

# ---- CPython 3.14.x from source (frappe version-16 requires >=3.14,<3.15) ----
# System python3.10 stays for the bench CLI; /usr/local/bin/python3.14 for the bench venv.
# Pin: Python-3.14.7.tgz sha256 verified against docker-library/python's GPG-checked
# release pin via identical .tar.xz content tree (no SHA256SUMS published by python.org).
RUN curl -fsSL -o /tmp/cpython.tgz https://www.python.org/ftp/python/3.14.7/Python-3.14.7.tgz \
    && echo "62859805f6fdf25e2bcbf3fa3217801e1996887ca33e6a2af80674bdfa2dbe07  /tmp/cpython.tgz" | sha256sum -c - \
    && tar -xzf /tmp/cpython.tgz -C /tmp \
    && cd /tmp/Python-3.14.7 \
    && ./configure --prefix=/usr/local --with-ensurepip=install > /dev/null \
    && make -j"$(nproc)" > /dev/null \
    && make altinstall > /dev/null \
    && cd / && rm -rf /tmp/Python-3.14.7 /tmp/cpython.tgz \
    && /usr/local/bin/python3.14 --version

# ---- patched wkhtmltopdf (official jammy build) ------------------------------
RUN curl -fsSL -o /tmp/wkhtmltox.deb \
      https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-2/wkhtmltox_0.12.6.1-2.jammy_amd64.deb \
    && ( dpkg -i /tmp/wkhtmltox.deb \
         || { apt-get update && apt-get -f install -y; } ) \
    && rm -f /tmp/wkhtmltox.deb \
    && wkhtmltopdf --version | grep -q 'patched qt'

# ---- frappe-required MariaDB tuning ------------------------------------------
COPY appliance/mariadb/50-basapos.cnf /etc/mysql/mariadb.conf.d/50-basapos.cnf

# ---- overlay consumed by provision (nginx site conf) --------------------------
COPY appliance/overlay/etc/nginx/ /etc/nginx/

# ---- provisioning payload -----------------------------------------------------
COPY --chmod=0755 appliance/provision.sh /opt/provision.sh
COPY apps.json /tmp/apps.json

# ---- provision -----------------------------------------------------------------
RUN bash /opt/provision.sh

# ---- WSL-only overlay: not read by provision; kept after it so config tweaks
#      don't invalidate the expensive provision layer ---------------------------
COPY appliance/overlay/etc/wsl.conf /etc/wsl.conf
COPY appliance/overlay/etc/hosts /etc/hosts

CMD ["/bin/bash"]
