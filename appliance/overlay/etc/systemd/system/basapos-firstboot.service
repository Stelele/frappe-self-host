[Unit]
Description=BasaPOS firstboot (load images, create site)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# docker load + new-site + migrate can take 10-30 min on POS disks;
# the 90s default would SIGKILL the run mid-phase
TimeoutStartSec=infinity
RemainAfterExit=yes
# Transient phase failures (e.g. mariadb fresh-volume init exceeding its
# healthcheck retries on slow disks) must NOT kill the install: restart the
# script; sentinels skip completed phases so re-runs converge. Bounded so a
# genuinely broken stack gives up rather than looping forever.
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=1800
StartLimitBurst=10
ExecStart=/usr/local/sbin/basapos-firstboot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
