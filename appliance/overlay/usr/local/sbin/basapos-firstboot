#!/usr/bin/env bash
# BasaPOS firstboot — phased, crash-safe. One sentinel per phase under
# /var/lib/basapos/firstboot/. A power-cut at ANY point converges on re-run.
set -uo pipefail

B=/opt/basapos
C=$B/compose
STATE=/var/lib/basapos/firstboot
CREDS=/mnt/c/BasaPOS/config
LOG=/var/log/basapos-firstboot.log
WINLOG=/mnt/c/BasaPOS/logs/firstboot.log

log() {
  local line; line="$(date -u +%FT%TZ) [$1] $2"
  echo "$line" | tee -a "$LOG" >&2
  echo "$line" >> "$WINLOG" 2>/dev/null || true
}
done_phase() { [ -f "$STATE/$1" ]; }
mark() { touch "$STATE/$1"; }
dc() { docker compose --env-file "$C/.env" -f "$C/compose.final.yaml" "$@"; }

mkdir -p "$STATE" /mnt/c/BasaPOS/logs
touch "$WINLOG" 2>/dev/null || true

ADMIN_PW=""
[ -r "$CREDS/install-password.txt" ] && ADMIN_PW="$(tr -d '\r\n' < "$CREDS/install-password.txt")"
[ -n "$ADMIN_PW" ] || { log fatal "missing $CREDS/install-password.txt — GUI must write it before import"; exit 1; }

if ! done_phase loaded; then
  log 1 "docker load images.tar"
  docker load -i "$B/images.tar" >>"$LOG" 2>&1 && mark loaded || { log 1 "load failed"; exit 1; }
fi

if ! done_phase env; then
  log 2 "generate DB password + .env"
  # persist the pw in $STATE: a kill between the compose sed and mark env
  # must NOT regenerate a different pw on re-run (placeholder already
  # consumed → permanent mismatch wedge)
  if [ -s "$STATE/db-password" ]; then
    DBPW="$(cat "$STATE/db-password")"
  else
    DBPW="$(tr -dc A-Za-z0-9 </dev/urandom | head -c 24)"
    printf '%s' "$DBPW" > "$STATE/db-password"
    chmod 0600 "$STATE/db-password"
  fi
  sed "s|__GENERATED_AT_FIRSTBOOT__|$DBPW|" "$C/.env.template" > "$C/.env"
  # compose.final.yaml was resolved by `docker compose config` at build time —
  # the DB_PASSWORD placeholder is baked as a literal and must be replaced
  # here too (env-file cannot re-resolve plain literals)
  sed -i "s|__GENERATED_AT_FIRSTBOOT__|$DBPW|" "$C/compose.final.yaml"
  printf 'DB_ROOT_PASSWORD=%s\n' "$DBPW" >> "$CREDS/credentials.txt"
  mark env
fi

# credentials.txt may hold a duplicate line if a previous run died between
# append and mark — always consume the LATEST entry.
DB_ROOT_PW="$(grep '^DB_ROOT_PASSWORD=' "$CREDS/credentials.txt" | cut -d= -f2 | tail -1)"
[ -n "$DB_ROOT_PW" ] || { log fatal "DB_ROOT_PASSWORD unreadable in credentials.txt"; exit 1; }

# compose service names per the generated chain: db (NOT mariadb-db),
# redis-cache, redis-queue. `run --rm configurator` propagates the oneshot's
# exit code (attached `up` swallows it: empirically returns 0 on failure) and
# ignores the restart policy.
if ! done_phase stack; then
  log 3 "start db + cache tiers + configurator"
  dc up -d db redis-cache redis-queue >>"$LOG" 2>&1 \
    && dc run --rm configurator >>"$LOG" 2>&1 \
    && mark stack || { log 3 "tier start failed"; exit 1; }
fi

if ! done_phase site; then
  if dc run --rm --no-deps backend test -d sites/basapos.local; then
    log 4 "site exists (partial previous run) — skip new-site, migrate only"
  else
    log 4 "new-site basapos.local"
    # Read apps.txt with the entrypoint OVERRIDDEN: `compose run` goes through
    # the backend image's entrypoint, whose "Linking fresh assets to volume..."
    # stdout echo pollutes the captured list (v3 field bug: --install-app
    # Linking). The Linux flow's create-site.sh uses `exec` (no entrypoint).
    APPS="$(dc run --rm --no-deps --entrypoint sh backend -c "cat sites/apps.txt" 2>>"$LOG" \
      | grep -v '^frappe$' | tr '\n' ' ')"
    [ -n "$APPS" ] || { log 4 "apps.txt unreadable"; exit 1; }
    FLAGS=""
    for a in $APPS; do
      # app names are python module names — anything else means the capture
      # got polluted; fail HERE with a clear message, not deep inside frappe
      echo "$a" | grep -Eq '^[a-z][a-z0-9_]*$' \
        || { log 4 "invalid app name in apps.txt: '$a'"; exit 1; }
      FLAGS="$FLAGS --install-app $a"
    done
    # shellcheck disable=SC2086
    dc run --rm --no-deps backend bench new-site \
      --mariadb-user-host-login-scope=% \
      --db-root-password "$DB_ROOT_PW" \
      $FLAGS --admin-password "$ADMIN_PW" basapos.local >>"$LOG" 2>&1 \
      || { log 4 "new-site failed"; exit 1; }
  fi
  # NOTE: no runtime `bench build` / asset tar-pipe — assets are baked into
  # the image layer at CI build (frappe_docker layered Containerfile); runtime
  # builds in `run --rm` containers would be discarded with the container.
  dc run --rm --no-deps backend bench --site basapos.local migrate >>"$LOG" 2>&1 \
    || { log 4 "migrate failed"; exit 1; }
  mark site
fi

if ! done_phase cert; then
  log 5 "per-install certificate"
  RAND="$(tr -dc a-z0-9 </dev/urandom | head -c 8)"
  openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout "$B/certs/key.pem" -out "$B/certs/cert.pem" \
    -subj "/CN=basapos-$RAND.local" -addext "subjectAltName=DNS:basapos.local" >>"$LOG" 2>&1 \
    || { log 5 "cert generation failed"; exit 1; }
  cp "$B/certs/cert.pem" "$CREDS/basapos.crt" \
    || { log 5 "cert copy-out failed"; exit 1; }
  # the proxy bind-mounts /opt/basapos/certs AT /certs — dynamic.yml must use
  # the CONTAINER-side paths
  cat > "$B/certs/dynamic.yml" <<'EOF' || { log 5 "dynamic.yml write failed"; exit 1; }
tls:
  certificates:
    - certFile: /certs/cert.pem
      keyFile: /certs/key.pem
EOF
  mark cert
fi

if ! done_phase booted; then
  log 6 "full stack up --wait"
  dc up -d --wait >>"$LOG" 2>&1 && mark booted || { log 6 "stack failed to come up"; exit 1; }
fi

if ! done_phase done; then
  log 7 "cleanup images.tar"
  rm -f "$B/images.tar"
  mark done
fi

log done "firstboot complete"
